datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          BigInt    @id @default(autoincrement())
  email       String    @unique
  username    String    @unique
  password    String
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  profile           Profile?
  ownedFingers      FingerRelation[] @relation("ownerUser")
  targetedFingers   FingerRelation[] @relation("targetUser")
  posts             Post[]
  postComments      PostComment[]
  stories           Story[]
  messages          Message[]
  messageRoomsUser1 MessageRoom[]    @relation("user1")
  messageRoomsUser2 MessageRoom[]    @relation("user2")
  receivedNotifications Notification[] @relation("notificationRecipient")
  actedNotifications    Notification[] @relation("notificationActor")

  @@map("users")
}

model Profile {
  userId          BigInt    @id @map("user_id")
  displayName     String?   @map("display_name") @db.VarChar(50)
  bio             String?   @db.VarChar(255)
  profileImageUrl String?   @map("profile_image_url")
  profileImageFocusX Float  @default(50) @map("profile_image_focus_x")
  profileImageFocusY Float  @default(50) @map("profile_image_focus_y")
  profileImageScale  Float  @default(1)  @map("profile_image_scale")
  isInfluencerMode Boolean  @default(false) @map("is_influencer_mode")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model FingerRelation {
  id          BigInt    @id @default(autoincrement())
  ownerUserId BigInt    @map("owner_user_id")
  targetUserId BigInt   @map("target_user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  ownerUser  User @relation("ownerUser",  fields: [ownerUserId],  references: [id], onDelete: Cascade)
  targetUser User @relation("targetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@map("finger_relations")
}

model Post {
  id             BigInt    @id @default(autoincrement())
  authorUserId   BigInt    @map("author_user_id")
  contentText    String?   @map("content_text") @db.Text
  visibilityType String    @default("PUBLIC") @map("visibility_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  author      User             @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  mediaAssets PostMediaAsset[]
  comments    PostComment[]

  @@map("posts")
}

model PostComment {
  id           BigInt    @id @default(autoincrement())
  postId       BigInt    @map("post_id")
  authorUserId BigInt    @map("author_user_id")
  parentCommentId BigInt? @map("parent_comment_id")
  body         String    @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentComment PostComment? @relation("PostCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@map("post_comments")
}

model PostMediaAsset {
  id             BigInt   @id @default(autoincrement())
  postId         BigInt   @map("post_id")
  mediaObjectKey String   @map("media_object_key")
  mediaType      String   @map("media_type")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_media_assets")
}

model Story {
  id             BigInt    @id @default(autoincrement())
  authorUserId   BigInt    @map("author_user_id")
  contentText    String?   @map("content_text") @db.Text
  visibilityType String    @default("PUBLIC") @map("visibility_type")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  author      User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  mediaAssets StoryMediaAsset[]

  @@map("stories")
}

model StoryMediaAsset {
  id             BigInt   @id @default(autoincrement())
  storyId        BigInt   @map("story_id")
  mediaObjectKey String   @map("media_object_key")
  mediaType      String   @map("media_type")
  createdAt      DateTime @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_media_assets")
}

model MessageRoom {
  id            BigInt    @id @default(autoincrement())
  user1Id       BigInt    @map("user1_id")
  user2Id       BigInt    @map("user2_id")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deactivatedAt DateTime? @map("deactivated_at")

  user1    User      @relation("user1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("user2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@map("message_rooms")
}

model Message {
  id                  BigInt    @id @default(autoincrement())
  roomId              BigInt    @map("room_id")
  senderUserId        BigInt    @map("sender_user_id")
  messageType         String    @map("message_type")
  body                String?   @db.Text
  attachmentObjectKey String?   @map("attachment_object_key")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  room   MessageRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id              BigInt    @id @default(autoincrement())
  recipientUserId BigInt    @map("recipient_user_id")
  actorUserId     BigInt?   @map("actor_user_id")
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(100)
  body            String    @db.VarChar(255)
  linkPath        String?   @map("link_path") @db.VarChar(255)
  isRead          Boolean   @default(false) @map("is_read")
  createdAt       DateTime  @default(now()) @map("created_at")
  readAt          DateTime? @map("read_at")

  recipient User  @relation("notificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("notificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientUserId, isRead])
  @@map("notifications")
}
